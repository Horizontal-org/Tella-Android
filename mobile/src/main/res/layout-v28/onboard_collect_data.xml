<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_purple"
    android:orientation="vertical">

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/onboarding_share_data_pager_gap">

        <TextView
            android:id="@+id/sheet_title"
            style="@style/Typography.Heading1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:paddingHorizontal="21dp"
            android:text="@string/Onboard_Collect_Data"
            android:textColor="@color/wa_white" />

        <TextView
            android:id="@+id/sheet_subtitle"
            style="@style/Typography.Body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingHorizontal="21dp"
            android:text="@string/Onboard_Collect_Data_Exp"
            android:textAlignment="center"
            android:textColor="@color/wa_white" />

        <TextView
            android:id="@+id/connections_heading"
            style="@style/Typography.Subheading1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:paddingHorizontal="21dp"
            android:text="@string/onboard.share_data_connections"
            android:textAlignment="center"
            android:textColor="@color/wa_white"
            tools:ignore="RtlSymmetry" />

        <LinearLayout
            android:id="@+id/connections_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="17dp"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="yes"
            android:orientation="vertical" />

    </LinearLayout>

</LinearLayout>
