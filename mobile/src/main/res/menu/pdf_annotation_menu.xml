    <!-- 2025-08-20 (audit-fix rev 9): manual rotate button. Cycles
         requestedOrientation through PORTRAIT → LANDSCAPE → UNSPECIFIED
         (follow device). Uses the existing rotate_image drawable
         (white 24dp vector with two curved arrows). -->
    <item
        android:id="@+id/menu_item_pdf_rotate"
        android:title="@string/pdf_annot_title_rotate"
        app:showAsAction="ifRoom"
        android:icon="@drawable/rotate_image" />

    <item
        android:id="@+id/menu_item_pdf_copy_text"
