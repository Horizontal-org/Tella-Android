    <!-- 2025-08-20 (audit-fix rev 8): dedicated Share menu item.
         Opens a dialog asking whether to bake annotations into the PDF
         or share the original. The existing "more" overflow → share path
         (VaultActionsHelper) still works but doesn't flatten annotations. -->
    <item
        android:id="@+id/menu_item_pdf_share"
        android:title="@string/pdf_share_title"
        app:showAsAction="never" />

