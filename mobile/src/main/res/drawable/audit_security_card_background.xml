<?xml version="1.0" encoding="utf-8"?>
<!--
  2025-08-20 (audit-fix rev 9): transparent-background variant of
  rounded_light_purple_background for the audit_security_layout card.

  The original rounded_light_purple_background uses a solid #10FFFFFF
  fill. When the audit_security_layout's last visible row
  (quickDeletePinSetting) has internal bottom padding (16dp from
  InfoSettingsView's settings_info_view.xml), the LinearLayout's
  measured height exceeds its visible content, and the solid fill
  draws a visible "blank card" rectangle below the last row.

  This drawable has NO solid fill — just rounded corners with a subtle
  1dp border. Any gap below the last row is transparent (shows the
  parent's dark_purple background), so the user perceives the card as
  terminating cleanly at the last row.

  Used only by audit_security_layout. The other cards in the Settings
  screen still use rounded_light_purple_background (which is correct
  for them because their last row has isBottomLineVisible=false and
  the fill provides the card's visual weight).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="15dp" />
            <stroke
                android:width="1dp"
                android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
