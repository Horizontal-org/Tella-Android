<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="24dp"
    android:background="@drawable/drag_anchor_drawable">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        android:labelFor="@id/link"
        style="@style/Tella_Main_White_Text.MeduimbBold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/ouisync_import_repository" />

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Style_EditText"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:layout_marginTop="15dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:paddingHorizontal="0dp"
        android:id="@+id/link"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:imeOptions="actionDone"
        android:inputType="text|textMultiLine|textNoSuggestions"
        android:hint="@string/ouisync_link"
        android:textColorHint="@color/wa_white"
        android:minLines="1"
        android:maxLines="4"
        android:letterSpacing="0"
        android:scrollHorizontally="false"
        android:importantForAutofill="no"
        android:gravity="start"
        android:textSize="14sp"
        android:autofillHints="" />

    <TextView
        android:id="@+id/cancel_button"
        android:text="@string/action_cancel"
        app:layout_constraintEnd_toStartOf="@id/import_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginTop="28dp"
        style="@style/Tella_Main_White_Text.MeduimbBold"
        android:layout_marginEnd="30dp"
        />

    <TextView
        android:id="@+id/import_button"
        android:text="@string/ouisync_import_repository"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progress"
        android:layout_marginTop="28dp"
        style="@style/Tella_Main_White_Text.MeduimbBold"
        android:textSize="14sp"
        />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress"
        style="@style/Tella_Progress_Circular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/link"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
