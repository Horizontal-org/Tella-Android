<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_purple"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    tools:context=".views.activity.MetadataViewerActivity"
    tools:showIn="@layout/activity_metadata_viewer">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/verification_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/tella_main_vertical">

                    <TextView
                        android:id="@+id/helpIntroTv"
                        style="@style/Tella_Main_White_Text.Meduim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/verification.help.intro"
                        android:textColor="@color/wa_white" />

                    <TextView
                        android:id="@+id/helpIntroEvidenceTv"
                        style="@style/Tella_Main_White_Text.Meduim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.2"
                        android:textColor="@color/wa_white"
                        tools:text="This verification information can be used to corroborate evidence. Learn more" />

                    <TextView
                        android:id="@+id/helpIntroWarningTv"
                        style="@style/Tella_Main_White_Text.Meduim"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="20dp"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/verification.help.intro.warning"
                        android:textColor="@color/wa_white" />

                    <include
                        android:id="@+id/verificationCategories"
                        layout="@layout/include_verification_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/metadata_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/save_csv_button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_submit_later_button"
            android:fontFamily="@font/open_sans_semibold"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0.0214"
            android:stateListAnimator="@null"
            android:text="@string/verification.save_as.csv"
            android:textAllCaps="true"
            android:textColor="@color/wa_white"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
