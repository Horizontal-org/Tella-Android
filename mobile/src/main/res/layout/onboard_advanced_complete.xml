<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wa_purple"
    android:clipChildren="false"
    android:padding="21dp"
    app:behavior_hideable="true">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.57" />

    <ImageView
        android:id="@+id/server_icon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_onboard_finish"
        app:layout_constraintBottom_toTopOf="@+id/onboard_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/onboard_title"
        style="@style/OnboardingWelcomeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/onboard.title_advanced_complete"
        app:layout_constraintBottom_toTopOf="@+id/standard_sheet_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/standard_sheet_content"
        style="@style/Typography.Body1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/onboard.expl_all_done"
        android:textAlignment="center"
        android:textColor="@color/wa_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guidelineCenter" />

    <TextView
        android:id="@+id/startBtn"
        style="@style/OnboardingGetStarted"
        android:layout_width="0dp"
        android:layout_height="@dimen/onboarding_get_started_height"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="@dimen/onboarding_get_started_horizontal_margin"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_onboarding_get_started_selector"
        android:clickable="true"
        android:contentDescription="@string/onboard.go_btn_all_done"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:text="@string/onboard.go_btn_all_done"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/standard_sheet_content"
        app:layout_constraintWidth_max="@dimen/onboarding_get_started_width" />

</androidx.constraintlayout.widget.ConstraintLayout>
